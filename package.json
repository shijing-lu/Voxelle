{
  "name": "local-video-transcriber",
  "version": "0.1.0",
  "private": true,
  "author": "Local Video Transcriber",
  "type": "module",
  "description": "Windows desktop video transcription app",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "npm run build:main && vite build",
    "package:win": "npm run build && electron-builder --win nsis",
    "test": "npm run build:main && node --test",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "local.video.transcriber",
    "productName": "音频转文本",
    "electronDownload": { "mirror": "https://npmmirror.com/mirrors/electron/" },
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*", "node_modules/ffprobe-static/**/*"],
    "extraResources": [
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe", "to": "bin/ffmpeg.exe" },
      { "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe", "to": "bin/ffprobe.exe" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE", "to": "licenses/GPL-3.0.txt" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe.README", "to": "licenses/ffmpeg-build-readme.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "licenses/THIRD_PARTY_NOTICES.md" }
    ],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
